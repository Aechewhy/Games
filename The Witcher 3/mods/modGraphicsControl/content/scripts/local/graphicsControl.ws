		if ( GC_Track( cfg, was, cur, usr, 'GCV_CascadeShadowDistanceScale0', 2, 1.8, 1.0, 1.0, 1.0, 1.0, 1.8 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowDistanceScale0', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale0', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'CascadeShadowDistanceScale1', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_Shadows', 'GCP_CascadeShadowDistanceScale1', 1.5 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_CascadeShadowDistanceScale1', 2, 1.5, 1.0, 1.0, 1.0, 1.0, 1.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowDistanceScale1', GC_Str( 2, usr ) );
			changed = true;
