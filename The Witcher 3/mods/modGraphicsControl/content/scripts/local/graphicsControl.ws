	{
		case 0: return -1.0;
		case 1: return 0.05;
		case 2: return 0.1;
		case 3: return 0.2;
		case 4: return 0.3;
		case 5: return 0.5;
		case 6: return 0.75;
		case 7: return 1.0;
		case 8: return 1.5;
		case 9: return 2.0;
		case 10: return 3.0;
	}
	return -1.0;
}

function GC_I_PTAOGrassRadius( value : float ) : int
{
	var i, best : int;
	best = 0;
	for ( i = 1; i < 11; i += 1 )
	{
		if ( AbsF( GC_V_PTAOGrassRadius( i ) - value ) < AbsF( GC_V_PTAOGrassRadius( best ) - value ) )
		{
			best = i;
		}
	}
	return best;
}

