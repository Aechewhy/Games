		GC_Push( cfg, 'GC_Bind', 'CASDistanceDecayPower', 2, 1.5 );
		GC_Push( cfg, 'GC_Bind', 'CASDenoise', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CASFast', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'RCASAmount', 2, 0.2 );
		GC_Push( cfg, 'GC_Bind', 'FSRSharpnessLow', 2, 0.3 );
		GC_Push( cfg, 'GC_Bind', 'FSRSharpnessHigh', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'NISSharpness', 2, 0.2 );
		GC_Push( cfg, 'GC_Bind', 'TAAUseLDS', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'MotionBlurPositionTreshold', 2, 0.05 );
		GC_Push( cfg, 'GC_Bind', 'MotionBlurRotationTreshold', 2, 1.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_Sharpening', on );
