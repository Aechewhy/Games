			changed = true;
		}
		GC_Push( cfg, 'GC_BindTex', 'DetailTextureDownscale', 1, usr );
		cur = GC_GetNum( cfg, 'GC_BindTex', 'AtlasTextureDownscale', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_Textures', 'GCP_AtlasTextureDownscale', 0.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_AtlasTextureDownscale', 1, 0.0, 2.0, 1.0, 0.0, 0.0, 0.0 ) )
		{
