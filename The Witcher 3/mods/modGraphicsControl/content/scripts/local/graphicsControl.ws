		GC_Push( cfg, 'GC_Bind', 'PTHairInteriorExteriorDimmer', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughness', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughnessAzimuthal', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughnessLongitudinal', 2, -1.0 );
