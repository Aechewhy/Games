		case 'GCP_PTHairRoughness':
		case 'GCP_PTHairRoughnessAzimuthal':
		case 'GCP_PTHairRoughnessLongitudinal':
		case 'GCP_PTHairRoughnessExponent':
		case 'GCP_PTHairRootRoughness':
		case 'GCP_PTHairRootRoughnessRange':
		case 'GCP_PTHairWetRoughness':
		case 'GCP_PTHairDiffuseFloor':
		case 'GCP_PTHairRootAlphaFalloffOverride':
		case 'GCP_PTHairRootAlphaMode':
		case 'GCP_PTHairBSDFMode':
		case 'GCP_PTHairShadowOcclusionMode':
		case 'GCP_PTHairShadowOriginSpreadScope':
		case 'GCP_PTHairShadowOriginSpread':
		case 'GCP_PTHairAlphaTestMipLevel':
		case 'GCP_CausticsEnable':
		case 'GCP_CausticsOutputToPT':
		case 'GCP_CausticsMode':
		case 'GCP_CausticsStrength':
		case 'GCP_CausticsRefractedIntensity':
		case 'GCP_CausticsOnWaterIntensity':
		case 'GCP_CausticsReflectedIntensity':
		case 'GCP_CausticsChoppy':
		case 'GCP_CausticsAbsorption':
		case 'GCP_CausticsMaxIrradiance':
		case 'GCP_CausticsCasterResolution':
		case 'GCP_CausticsResolveRadius':
		case 'GCP_CausticsHalfExtent':
			return true;
	}
	return false;
}

function GC_ApplyPTPreset( idx : int )
{
	var cfg : CInGameConfigWrapper;
	cfg = theGame.GetInGameConfigWrapper();
	if ( !cfg || idx < 0 || idx > 5 )
	{
		return;
	}
	cfg.ApplyGroupPreset( 'GC_PathTracing', idx );
	GC_ApplyAll();
}

function GC_ToggleMaster()
{
	var cfg : CInGameConfigWrapper;
	var menu : CR4IngameMenu;
	var on : bool;
	cfg = theGame.GetInGameConfigWrapper();
	if ( !cfg )
	{
		return;
	}
	on = !GC_GetBool( cfg, 'GC_Presets', 'GCP_Master', true );
	GC_SetBool( cfg, 'GC_Presets', 'GCP_Master', on );
	GC_ApplyAll();
	theGame.SaveUserSettings();
	menu = theGame.GetGuiManager().GetIngameMenu();
	if ( menu )
	{
		menu.GC_Refresh( 'GC_Presets' );
	}
	if ( on )
	{
		theGame.GetGuiManager().ShowNotification( "VAXIS's Graphics Control: ON" );
	}
	else
	{
		theGame.GetGuiManager().ShowNotification( "VAXIS's Graphics Control: OFF (game settings)" );
	}
}

// ---- menu ----

@addField( CR4IngameMenu ) var gcBusy : bool;
@addField( CR4IngameMenu ) var gcBgHidden : bool;
@addField( CR4IngameMenu ) var gcBgScaleX : float;
@addField( CR4IngameMenu ) var gcBgScaleY : float;

// Shows the values of our submenus again after the script changed them. The menu only receives the
// last update of each frame, so every update (and the one the game queued before ours) goes out right away.
@addMethod( CR4IngameMenu ) function GC_Refresh( optional only : name )
{
	if ( gcBusy )
	{
		return;
	}
	gcBusy = true;
	theGame.GetGuiManager().ForceProcessFlashStorage();
	if ( only != '' )
	{
		GC_RefreshGroup( only );
	}
	else
	{
		GC_RefreshGroup( 'GC_Presets' );
		GC_RefreshGroup( 'GC_DrawDistance' );
		GC_RefreshGroup( 'GC_GrassFoliage' );
		GC_RefreshGroup( 'GC_Textures' );
		GC_RefreshGroup( 'GC_Shadows' );
		GC_RefreshGroup( 'GC_LightingRT' );
		GC_RefreshGroup( 'GC_PathTracing' );
		GC_RefreshGroup( 'GC_PTAmbientOcclusion' );
		GC_RefreshGroup( 'GC_PTHair' );
		GC_RefreshGroup( 'GC_PTCaustics' );
		GC_RefreshGroup( 'GC_Sharpening' );
		GC_RefreshGroup( 'GC_Water' );
		GC_RefreshGroup( 'GC_DecalsEffects' );
	}
	gcBusy = false;
}

@addMethod( CR4IngameMenu ) function GC_RefreshGroup( groupId : name )
{
	UpdatePresetOptions( groupId, false );
	theGame.GetGuiManager().ForceProcessFlashStorage();
}

// See-through menu: shrinks the menu's dark background to nothing while in a game, and gives the
// menu's text a dark outline so it stays readable over the game.
@addMethod( CR4IngameMenu ) function GC_SeeThrough()
{
	var bg : CScriptedFlashSprite;
	var hide : bool;
	if ( !m_flashModule )
	{
		return;
	}
	bg = m_flashModule.GetChildFlashSprite( "mcBlackBackground" );
	if ( !bg )
	{
		return;
	}
	hide = !isMainMenu && GC_GetBool( theGame.GetInGameConfigWrapper(), 'GC_Presets', 'GCP_SeeThrough', false );
	if ( hide && !gcBgHidden )
	{
		gcBgScaleX = bg.GetXScale();
		gcBgScaleY = bg.GetYScale();
		bg.SetXScale( 0.0001 );
		bg.SetYScale( 0.0001 );
		gcBgHidden = true;
		GC_Outline( true );
	}
	else if ( !hide && gcBgHidden )
	{
		bg.SetXScale( gcBgScaleX );
		bg.SetYScale( gcBgScaleY );
		gcBgHidden = false;
		GC_Outline( false );
	}
}

// A dark glow around everything in the option list, the menu list and the button bar (empty list = none).
@addMethod( CR4IngameMenu ) function GC_Outline( on : bool )
{
	var filters : CScriptedFlashArray;
	var glow : CScriptedFlashObject;
	filters = m_flashModule.CreateFlashArray();
	if ( on )
	{
		glow = m_flashModule.CreateFlashObject( "flash.filters.GlowFilter" );
		if ( glow )
		{
			glow.SetMemberFlashUInt( "color", 0 );
			glow.SetMemberFlashNumber( "alpha", 0.9 );
			glow.SetMemberFlashNumber( "blurX", 5.0 );
			glow.SetMemberFlashNumber( "blurY", 5.0 );
			glow.SetMemberFlashNumber( "strength", 4.0 );
			glow.SetMemberFlashInt( "quality", 2 );
			// a new glow is red: only use it once it is black
			if ( glow.GetMemberFlashUInt( "color" ) == 0 )
			{
				filters.PushBackFlashObject( glow );
			}
		}
	}
	GC_SetFilters( "mcOptionListModule", filters );
	GC_SetFilters( "menuListModule", filters );
	GC_SetFilters( "mcInputFeedbackModule", filters );
}

@addMethod( CR4IngameMenu ) function GC_SetFilters( child : string, filters : CScriptedFlashArray )
{
	var sprite : CScriptedFlashSprite;
	sprite = m_flashModule.GetChildFlashSprite( child );
	if ( sprite )
	{
		sprite.SetMemberFlashArray( "filters", filters );
	}
}

@wrapMethod( CR4IngameMenu ) function PopulateMenuData()
{
	GC_ApplyAll();
	wrappedMethod();
	GC_SeeThrough();
}

@wrapMethod( CR4IngameMenu ) function UpdatePresetOptions( groupId : name, applyLocks : bool )
{
	var changed : bool;
	wrappedMethod( groupId, applyLocks );
	if ( gcBusy )
	{
		return;
	}
	changed = GC_ApplyAll();
	if ( changed || StrBeginsWith( NameToString( groupId ), "GC_" ) )
	{
		GC_Refresh();
	}
}

@wrapMethod( CR4Game ) function OnConfigValueChanged( varName : name, value : string ) : void
{
	var menu : CR4IngameMenu;
	var changed : bool;
	wrappedMethod( varName, value );
	if ( varName == 'GCP_PTPreset' )
	{
		GC_ApplyPTPreset( StringToInt( value ) );
		changed = true;
	}
	else
	{
		if ( GC_IsPTSetting( varName ) )
		{
			GetInGameConfigWrapper().SetVarValue( 'GC_Presets', 'GCP_PTPreset', "6" );
		}
		changed = GC_ApplyAll();
	}
	menu = GetGuiManager().GetIngameMenu();
	if ( menu )
	{
		if ( changed )
		{
			menu.GC_Refresh();
		}
		else if ( GC_IsPTSetting( varName ) )
		{
			menu.GC_Refresh( 'GC_Presets' );
		}
		if ( varName == 'GCP_SeeThrough' )
		{
			menu.GC_SeeThrough();
		}
	}
}

// Descriptions: the options list shows an option's "description" in the box under the list.
@replaceMethod function SetDescriptionText( optionObject : CScriptedFlashObject, optionName : name, optionValue : string )
{
	var text : string;
	if( optionName == 'EnableRT' && (theGame.GetPlatform() == Platform_PS5 || theGame.GetPlatform() == Platform_Xbox_SCARLETT_ANACONDA) )
	{
		optionObject.SetMemberFlashString( "descriptionTrue", GetLocStringByKeyExt("panel_video_quality_mode_tooltip") );
		optionObject.SetMemberFlashString( "descriptionFalse", GetLocStringByKeyExt("panel_video_performance_mode_tooltip") );
	}
	else if( optionName == 'LockhartPerformanceMode' )
	{
		optionObject.SetMemberFlashString( "descriptionFalse", GetLocStringByKeyExt("option_lockhart_performance_mode_description_quality") );
		optionObject.SetMemberFlashString( "descriptionTrue", GetLocStringByKeyExt("option_lockhart_performance_mode_description_performance") );
	}
	if ( StrBeginsWith( NameToString( optionName ), "GCP_" ) )
	{
		text = GetLocStringByKeyExt( StrLower( "gc_desc_" + NameToString( optionName ) ) );
		if ( text != "" )
		{
			optionObject.SetMemberFlashString( "description", text );
		}
	}
}

// ---- F2 key (action GC_ToggleMod in input.settings) ----

class CGCHotkey
{
	event OnGCToggle( action : SInputAction )
	{
		if ( IsPressed( action ) )
		{
			GC_ToggleMaster();
		}
	}
}

@addField( CR4Game ) var gcHotkey : CGCHotkey;

// theGame is read-only from outside, so the game object keeps the listener itself.
@addMethod( CR4Game ) function GC_RegisterHotkey()
{
	if ( !gcHotkey )
	{
		gcHotkey = new CGCHotkey in this;
	}
	theInput.RegisterListener( gcHotkey, 'OnGCToggle', 'GC_ToggleMod' );
}

@wrapMethod( CCommonMapManager ) function OnGameStarted()
{
	wrappedMethod();
	GC_ApplyAll();
	theGame.GC_RegisterHotkey();
}
