		{
			best = i;
		}
	}
	return best;
}

// ---- first start ----

function GC_InitStore( cfg : CInGameConfigWrapper )
{
	var ver : float;
	ver = GC_GetNum( cfg, 'GC_Store', 'GC_Version', 0.0 );
	if ( ver >= 4 )
	{
		return;
	}
	if ( ver < 1 )
	{
		// settings the game does not save (fresh install)
		cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_GrassDensityLodScale', "0.75" );
		cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_WindScale', "0.7" );
		cfg.SetVarValue( 'GC_LightingRT', 'GCP_RTSTTrees', "true" );
		cfg.SetVarValue( 'GC_LightingRT', 'GCP_RTSTBillboards', "true" );
		cfg.SetVarValue( 'GC_LightingRT', 'GCP_RTSTGrass', "false" );
		cfg.SetVarValue( 'GC_LightingRT', 'GCP_RTSTConfigUpdateDistance', "20" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSunImpact', "1" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSkyImpact', "1" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTDirectLightImpact', "1" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSkinIndirectDesaturation', "0.5" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTAnalyticSkyExposure', "0.12" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTAnalyticSkyTurbidity', "3.5" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTGameLightsIndirect', "false" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTGameLightsScale', "0" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTAllSceneFakeLightsScale', "0" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTCameraNonCharactersScale', "0" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTLocalLightMaskEnable', "true" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTDimmerEnable', "false" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTGrassScale', "0" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTGrassNightScale', "0" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTEnableGlobalOcean', "true" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTUseSHARC', "false" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcEntriesNumLog2', "2" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcDownscaleFactor', "5" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcAccumulationFrameNum', "32" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcStaleFrameNum', "64" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcSceneScale', "50" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_PTSharcRoughnessMin', "0.4" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOEnable', "true" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOQuality', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAODenoisePasses', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOStrength', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAORadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAORadiusMultiplier', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOFalloffRange', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOFinalValuePower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOCharacterRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOSkinRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOHairRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOTerrainRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOTreesRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOGrassRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOEnvironmentRadius', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOCharacterPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOSkinPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOHairPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOTerrainPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOTreesPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOGrassPower', "0" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_PTAOEnvironmentPower', "0" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairDirectLightImpact', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairGlobalLightImpact', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairIndirectLightImpact', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairSpecularTintScale', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairGameLightIndirect', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairGameplayCameraFill', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairInteriorExteriorDimmer', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRoughness', "0" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRoughnessAzimuthal', "0" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRoughnessLongitudinal', "0" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRoughnessExponent', "0.25" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRootRoughness', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRootRoughnessRange', "0.05" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairWetRoughness', "0.03" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairDiffuseFloor', "0" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRootAlphaFalloffOverride', "0.06" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairRootAlphaMode', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairBSDFMode', "1" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairShadowOcclusionMode', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairShadowOriginSpreadScope', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairShadowOriginSpread', "32" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_PTHairAlphaTestMipLevel', "4" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsEnable', "false" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsOutputToPT', "false" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsMode', "0" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsStrength', "1" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsRefractedIntensity', "1" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsOnWaterIntensity', "0.2" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsReflectedIntensity', "1" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsChoppy', "1" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsAbsorption', "0.15" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsMaxIrradiance', "50" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsCasterResolution', "2" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsResolveRadius', "2" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_CausticsHalfExtent', "60" );
	}
	if ( ver < 2 )
	{
		// new in 1.2: settings the game saves start at what the engine has now
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MeshRenderingDistanceScale', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'MeshRenderingDistanceScale', 1.5 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_MeshRenderingDistanceScale', "1.5" );
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MeshLODDistanceScale', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'MeshLODDistanceScale', 1.5 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_MeshLODDistanceScale', "1.5" );
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_FoliageDistanceScale', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'FoliageDistanceScale', 1.8 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_FoliageDistanceScale', "1.8" );
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MaxVisibilityDepth', GC_Str( 1, GC_GetNum( cfg, 'GC_Bind', 'MaxVisibilityDepth', 24.0 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_MaxVisibilityDepth', "24" );
