// VAXIS's Graphics Control
// Copies the menu's values into the engine, or the game's own values while the mod or a submenu is off.
// Settings the game's Graphics menu also sets follow that menu until the player changes them here.
// Also: option descriptions, the path tracing preset list, the see-through menu and the F2 key.
// Generated by make_graphics_menu.py.

// ---- reading and writing values ----

function GC_GetNum( cfg : CInGameConfigWrapper, grp : name, id : name, fallback : float ) : float
{
	var value : string;
	value = cfg.GetVarValue( grp, id );
	if ( value == "" )
	{
		return fallback;
	}
	if ( value == "true" )
	{
		return 1.0;
	}
	if ( value == "false" )
	{
		return 0.0;
	}
	return StringToFloat( value, fallback );
}

function GC_GetBool( cfg : CInGameConfigWrapper, grp : name, id : name, fallback : bool ) : bool
{
	var value : string;
	value = cfg.GetVarValue( grp, id );
	if ( value == "true" || value == "1" )
	{
		return true;
	}
	if ( value == "false" || value == "0" )
	{
		return false;
	}
	return fallback;
}

function GC_SetBool( cfg : CInGameConfigWrapper, grp : name, id : name, value : bool )
{
	if ( value )
	{
		cfg.SetVarValue( grp, id, "true" );
	}
	else
	{
		cfg.SetVarValue( grp, id, "false" );
	}
}

// kind: 0 on/off, 1 whole number, 2 number
function GC_Str( kind : int, value : float ) : string
{
	if ( kind == 0 )
	{
		if ( value > 0.5 )
		{
			return "true";
		}
		return "false";
	}
	if ( kind == 1 )
	{
		return IntToString( RoundF( value ) );
	}
	return FloatToString( value );
}

function GC_Same( a : float, b : float ) : bool
{
	return AbsF( a - b ) < 0.0005;
}

function GC_Push( cfg : CInGameConfigWrapper, bind : name, id : name, kind : int, value : float )
{
	if ( !GC_Same( GC_GetNum( cfg, bind, id, value + 1000.0 ), value ) )
	{
		cfg.SetVarValue( bind, id, GC_Str( kind, value ) );
	}
}

function GC_IsVan( value : float, l0 : float, l1 : float, l2 : float, l3 : float, l4 : float ) : bool
{
	return GC_Same( value, l0 ) || GC_Same( value, l1 ) || GC_Same( value, l2 ) || GC_Same( value, l3 ) || GC_Same( value, l4 );
}

// A setting the game's Graphics menu also sets (its values there: l0..l4), cur = the engine's value,
// usr = the player's value here. If the engine holds a Graphics menu value we did not put there, that
// is the game's new value: remember it for "off" (GCV_*), and return true when the player never changed
// this setting here, so it follows the game.
function GC_Track( cfg : CInGameConfigWrapper, was : bool, cur : float, usr : float, vid : name, kind : int, dflt : float, l0 : float, l1 : float, l2 : float, l3 : float, l4 : float ) : bool
{
	var van : float;
	van = GC_GetNum( cfg, 'GC_Store', vid, dflt );
	if ( ( !was || !GC_Same( cur, usr ) ) && GC_IsVan( cur, l0, l1, l2, l3, l4 ) && !GC_Same( cur, van ) )
	{
		cfg.SetVarValue( 'GC_Store', vid, GC_Str( kind, cur ) );
		return GC_Same( usr, van );
	}
	return false;
}

// ---- list options: the menu stores the position in the list ----

function GC_V_GrassRingSize( idx : int ) : float
{
	switch ( idx )
	{
		case 0: return 2097152.0;
		case 1: return 3145728.0;
		case 2: return 6291456.0;
		case 3: return 8388608.0;
		case 4: return 12582912.0;
		case 5: return 16777216.0;
	}
	return 8388608.0;
}

function GC_I_GrassRingSize( value : float ) : int
{
	var i, best : int;
	best = 0;
	for ( i = 1; i < 6; i += 1 )
	{
		if ( AbsF( GC_V_GrassRingSize( i ) - value ) < AbsF( GC_V_GrassRingSize( best ) - value ) )
		{
			best = i;
		}
	}
	return best;
}

