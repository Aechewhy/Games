		GC_Push( cfg, 'GC_Bind', 'FSRSharpnessHigh', 2, GC_GetNum( cfg, 'GC_Sharpening', 'GCP_FSRSharpnessHigh', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'NISSharpness', 2, GC_GetNum( cfg, 'GC_Sharpening', 'GCP_NISSharpness', 0.2 ) );
		GC_Push( cfg, 'GC_Bind', 'TAAUseLDS', 0, GC_GetNum( cfg, 'GC_Sharpening', 'GCP_TAAUseLDS', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MotionBlurPositionTreshold', 2, GC_GetNum( cfg, 'GC_Sharpening', 'GCP_MotionBlurPositionTreshold', 0.05 ) );
		GC_Push( cfg, 'GC_Bind', 'MotionBlurRotationTreshold', 2, GC_GetNum( cfg, 'GC_Sharpening', 'GCP_MotionBlurRotationTreshold', 1.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'EnableCAS', 0, 1.0 );
