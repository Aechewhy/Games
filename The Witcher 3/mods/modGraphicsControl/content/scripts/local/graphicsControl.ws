		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsLimit', 1, GC_GetNum( cfg, 'GC_DecalsEffects', 'GCP_DynamicDecalsLimit', 60.0 ) );
		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsChunkLimit', 1, GC_GetNum( cfg, 'GC_DecalsEffects', 'GCP_DynamicDecalsChunkLimit', 30.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'DecalsChance', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'DecalsSpawnDistanceCutoff', 2, 10.0 );
		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsLimit', 1, 60.0 );
		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsChunkLimit', 1, 30.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_DecalsEffects', on );
	}
	return changed;
}

// Returns true when a value shown in the menu changed (it followed the game's Graphics menu).
function GC_ApplyAll() : bool
{
	var cfg : CInGameConfigWrapper;
	var master, changed : bool;
	cfg = theGame.GetInGameConfigWrapper();
	if ( !cfg )
	{
		return false;
	}
	GC_InitStore( cfg );
	master = GC_GetBool( cfg, 'GC_Presets', 'GCP_Master', true );
	if ( GC_Group_GC_DrawDistance( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_GrassFoliage( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_Textures( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_Shadows( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_LightingRT( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_PathTracing( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_PTAmbientOcclusion( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_PTHair( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_PTCaustics( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_Sharpening( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_Water( cfg, master ) ) { changed = true; }
	if ( GC_Group_GC_DecalsEffects( cfg, master ) ) { changed = true; }
	return changed;
}

function GC_IsPTSetting( varName : name ) : bool
{
	switch ( varName )
	{
		case 'GCP_PTSunImpact':
		case 'GCP_PTSkyImpact':
