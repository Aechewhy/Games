		usr = GC_GetNum( cfg, 'GC_Shadows', 'GCP_CascadeShadowDistanceScale2', 1.5 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_CascadeShadowDistanceScale2', 2, 1.5, 1.0, 1.0, 1.2, 1.5, 1.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowDistanceScale2', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale2', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'CascadeShadowDistanceScale3', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_Shadows', 'GCP_CascadeShadowDistanceScale3', 1.5 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_CascadeShadowDistanceScale3', 2, 1.5, 1.0, 1.0, 1.2, 1.5, 1.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowDistanceScale3', GC_Str( 2, usr ) );
