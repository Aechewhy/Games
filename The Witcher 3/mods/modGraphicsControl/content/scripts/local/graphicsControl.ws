		GC_Push( cfg, 'GC_Bind', 'CASDistanceBased', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CASAmountNear', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CASAmountFar', 2, 0.0 );
