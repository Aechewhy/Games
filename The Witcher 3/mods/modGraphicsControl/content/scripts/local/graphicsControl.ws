		GC_Push( cfg, 'GC_Bind', 'PTHairWetRoughness', 2, 0.03 );
		GC_Push( cfg, 'GC_Bind', 'PTHairDiffuseFloor', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootAlphaFalloffOverride', 2, 0.06 );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootAlphaMode', 1, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairBSDFMode', 1, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOcclusionMode', 1, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOriginSpreadScope', 1, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOriginSpread', 2, 32.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairAlphaTestMipLevel', 2, 4.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_PTHair', on );
	}
	return changed;
}

function GC_Group_GC_PTCaustics( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_PTCaustics', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_PTCaustics', false );
	if ( on )
	{
		GC_Push( cfg, 'GC_Bind', 'CausticsEnable', 0, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsEnable', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsOutputToPT', 0, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsOutputToPT', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsMode', 1, GC_V_CausticsMode( RoundF( GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsMode', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsStrength', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsStrength', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsRefractedIntensity', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsRefractedIntensity', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsOnWaterIntensity', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsOnWaterIntensity', 0.2 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsReflectedIntensity', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsReflectedIntensity', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsChoppy', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsChoppy', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsAbsorption', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsAbsorption', 0.15 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsMaxIrradiance', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsMaxIrradiance', 50.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsCasterResolution', 1, GC_V_CausticsCasterResolution( RoundF( GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsCasterResolution', 2.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsResolveRadius', 1, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsResolveRadius', 2.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CausticsHalfExtent', 2, GC_GetNum( cfg, 'GC_PTCaustics', 'GCP_CausticsHalfExtent', 60.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'CausticsEnable', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsOutputToPT', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsMode', 1, 7.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsStrength', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsRefractedIntensity', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsOnWaterIntensity', 2, 0.2 );
		GC_Push( cfg, 'GC_Bind', 'CausticsReflectedIntensity', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsChoppy', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsAbsorption', 2, 0.15 );
		GC_Push( cfg, 'GC_Bind', 'CausticsMaxIrradiance', 2, 50.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsCasterResolution', 1, 2048.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsResolveRadius', 1, 2.0 );
		GC_Push( cfg, 'GC_Bind', 'CausticsHalfExtent', 2, 60.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_PTCaustics', on );
	}
	return changed;
}

