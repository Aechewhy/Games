		usr = GC_GetNum( cfg, 'GC_Textures', 'GCP_TextureMemoryBudget', 1200.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_TextureMemoryBudget', 1, 1200.0, 400.0, 600.0, 800.0, 1200.0, 1200.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Textures', 'GCP_TextureMemoryBudget', GC_Str( 1, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_BindTex', 'TextureMemoryBudget', 1, usr );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingDistanceLimitSq', 2, GC_GetNum( cfg, 'GC_Textures', 'GCP_TextureStreamingDistanceLimitSq', 40000.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingCharacterDistanceLimitSq', 2, GC_GetNum( cfg, 'GC_Textures', 'GCP_TextureStreamingCharacterDistanceLimitSq', 225.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingHeadsDistanceLimitSq', 2, GC_GetNum( cfg, 'GC_Textures', 'GCP_TextureStreamingHeadsDistanceLimitSq', 100.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureInFlightCountBudget', 1, GC_GetNum( cfg, 'GC_Textures', 'GCP_TextureInFlightCountBudget', 12.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_BindTex', 'MaxTextureAnizotropy', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxTextureAnizotropy', 16.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureMipBias', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_TextureMipBias', -2.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'MaxTextureSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxTextureSize', 4096.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'MaxAtlasTextureSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxAtlasTextureSize', 4096.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureDownscale', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_TextureDownscale', 0.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'DetailTextureDownscale', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_DetailTextureDownscale', 0.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'AtlasTextureDownscale', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_AtlasTextureDownscale', 0.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureMemoryBudget', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_TextureMemoryBudget', 1200.0 ) );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingDistanceLimitSq', 2, 40000.0 );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingCharacterDistanceLimitSq', 2, 225.0 );
		GC_Push( cfg, 'GC_BindTex', 'TextureStreamingHeadsDistanceLimitSq', 2, 100.0 );
		GC_Push( cfg, 'GC_BindTex', 'TextureInFlightCountBudget', 1, 12.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_Textures', on );
	}
	return changed;
}

function GC_Group_GC_Shadows( cfg : CInGameConfigWrapper, master : bool ) : bool
