		if ( GC_Track( cfg, was, cur, usr, 'GCV_TextureDownscale', 1, 0.0, 2.0, 1.0, 0.0, 0.0, 0.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Textures', 'GCP_TextureDownscale', GC_Str( 1, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_BindTex', 'TextureDownscale', 1, usr );
