		GC_Push( cfg, 'GC_Bind', 'MaxSpotShadowSize', 1, usr );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowmapSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowmapSize', 4096.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowQuality', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowQuality', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MaxCascadeCount', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxCascadeCount', 4.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale0', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowDistanceScale0', 1.8 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale1', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowDistanceScale1', 1.5 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale2', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowDistanceScale2', 1.5 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale3', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowDistanceScale3', 1.5 ) );
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowFadeTreshold', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_CascadeShadowFadeTreshold', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MaxTerrainShadowAtlasCount', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxTerrainShadowAtlasCount', 4.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MaxCubeShadowSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxCubeShadowSize', 512.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MaxSpotShadowSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxSpotShadowSize', 512.0 ) );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_Shadows', on );
	}
	return changed;
}

function GC_Group_GC_LightingRT( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_LightingRT', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_LightingRT', false );
	if ( on )
	{
		GC_Push( cfg, 'GC_Bind', 'BalanceModeRT', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_BalanceModeRT', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RTAOHalfResolution', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RTAOHalfResolution', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'EnableAOPretrace', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_EnableAOPretrace', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'EnableAOSSSampling', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_EnableAOSSSampling', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RtRadianceScreenSpaceTrace', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RtRadianceScreenSpaceTrace', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'ProbeMaxRayDist', 2, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_ProbeMaxRayDist', 128.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RTSTTrees', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RTSTTrees', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RTSTBillboards', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RTSTBillboards', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RTSTGrass', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RTSTGrass', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'RTSTConfigUpdateDistance', 2, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_RTSTConfigUpdateDistance', 20.0 ) );
		GC_Push( cfg, 'GC_Bind', 'UseHBIL', 0, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_UseHBIL', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'HBILImpact', 2, GC_GetNum( cfg, 'GC_LightingRT', 'GCP_HBILImpact', 1.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'BalanceModeRT', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'RTAOHalfResolution', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'EnableAOPretrace', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'EnableAOSSSampling', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'RtRadianceScreenSpaceTrace', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'ProbeMaxRayDist', 2, 128.0 );
		GC_Push( cfg, 'GC_Bind', 'RTSTTrees', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'RTSTBillboards', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'RTSTGrass', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'RTSTConfigUpdateDistance', 2, 20.0 );
		GC_Push( cfg, 'GC_Bind', 'UseHBIL', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'HBILImpact', 2, 1.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_LightingRT', on );
	}
	return changed;
}

function GC_Group_GC_PathTracing( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_PathTracing', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_PathTracing', false );
	if ( on )
	{
		GC_Push( cfg, 'GC_Bind', 'PTSunImpact', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSunImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSkyImpact', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSkyImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTDirectLightImpact', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTDirectLightImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSkinIndirectDesaturation', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSkinIndirectDesaturation', 0.5 ) );
		GC_Push( cfg, 'GC_Bind', 'PTAnalyticSkyExposure', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTAnalyticSkyExposure', 0.12 ) );
		GC_Push( cfg, 'GC_Bind', 'PTAnalyticSkyTurbidity', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTAnalyticSkyTurbidity', 3.5 ) );
		GC_Push( cfg, 'GC_Bind', 'PTGameLightsIndirect', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTGameLightsIndirect', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTGameLightsScale', 2, GC_V_PTGameLightsScale( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTGameLightsScale', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAllSceneFakeLightsScale', 2, GC_V_PTAllSceneFakeLightsScale( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTAllSceneFakeLightsScale', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTCameraNonCharactersScale', 2, GC_V_PTCameraNonCharactersScale( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTCameraNonCharactersScale', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTLocalLightMaskEnable', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTLocalLightMaskEnable', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTDimmerEnable', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTDimmerEnable', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTGrassScale', 2, GC_V_PTGrassScale( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTGrassScale', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTGrassNightScale', 2, GC_V_PTGrassNightScale( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTGrassNightScale', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTEnableGlobalOcean', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTEnableGlobalOcean', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTLateSpecularScreenSpaceTrace', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTLateSpecularScreenSpaceTrace', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTLateSpecularCheckerboard', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTLateSpecularCheckerboard', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTUseSHARC', 0, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTUseSHARC', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcEntriesNumLog2', 1, GC_V_PTSharcEntriesNumLog2( RoundF( GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcEntriesNumLog2', 2.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcDownscaleFactor', 1, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcDownscaleFactor', 5.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcAccumulationFrameNum', 1, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcAccumulationFrameNum', 32.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcStaleFrameNum', 1, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcStaleFrameNum', 64.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcSceneScale', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcSceneScale', 50.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTSharcRoughnessMin', 2, GC_GetNum( cfg, 'GC_PathTracing', 'GCP_PTSharcRoughnessMin', 0.4 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'PTSunImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSkyImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTDirectLightImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSkinIndirectDesaturation', 2, 0.5 );
		GC_Push( cfg, 'GC_Bind', 'PTAnalyticSkyExposure', 2, 0.12 );
		GC_Push( cfg, 'GC_Bind', 'PTAnalyticSkyTurbidity', 2, 3.5 );
		GC_Push( cfg, 'GC_Bind', 'PTGameLightsIndirect', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'PTGameLightsScale', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAllSceneFakeLightsScale', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTCameraNonCharactersScale', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTLocalLightMaskEnable', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTDimmerEnable', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'PTGrassScale', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTGrassNightScale', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTEnableGlobalOcean', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTLateSpecularScreenSpaceTrace', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTLateSpecularCheckerboard', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTUseSHARC', 0, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcEntriesNumLog2', 1, 22.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcDownscaleFactor', 1, 5.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcAccumulationFrameNum', 1, 32.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcStaleFrameNum', 1, 64.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcSceneScale', 2, 50.0 );
		GC_Push( cfg, 'GC_Bind', 'PTSharcRoughnessMin', 2, 0.4 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_PathTracing', on );
	}
	return changed;
}

function GC_Group_GC_PTAmbientOcclusion( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_PTAmbientOcclusion', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_PTAmbientOcclusion', false );
	if ( on )
	{
		GC_Push( cfg, 'GC_Bind', 'PTAOEnable', 0, GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOEnable', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOQuality', 1, GC_V_PTAOQuality( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOQuality', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAODenoisePasses', 1, GC_V_PTAODenoisePasses( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAODenoisePasses', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOStrength', 2, GC_V_PTAOStrength( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOStrength', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAORadius', 2, GC_V_PTAORadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAORadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAORadiusMultiplier', 2, GC_V_PTAORadiusMultiplier( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAORadiusMultiplier', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOFalloffRange', 2, GC_V_PTAOFalloffRange( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOFalloffRange', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOFinalValuePower', 2, GC_V_PTAOFinalValuePower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOFinalValuePower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOCharacterRadius', 2, GC_V_PTAOCharacterRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOCharacterRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOSkinRadius', 2, GC_V_PTAOSkinRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOSkinRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOHairRadius', 2, GC_V_PTAOHairRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOHairRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOTerrainRadius', 2, GC_V_PTAOTerrainRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOTerrainRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOTreesRadius', 2, GC_V_PTAOTreesRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOTreesRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOGrassRadius', 2, GC_V_PTAOGrassRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOGrassRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOEnvironmentRadius', 2, GC_V_PTAOEnvironmentRadius( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOEnvironmentRadius', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOCharacterPower', 2, GC_V_PTAOCharacterPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOCharacterPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOSkinPower', 2, GC_V_PTAOSkinPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOSkinPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOHairPower', 2, GC_V_PTAOHairPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOHairPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOTerrainPower', 2, GC_V_PTAOTerrainPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOTerrainPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOTreesPower', 2, GC_V_PTAOTreesPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOTreesPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOGrassPower', 2, GC_V_PTAOGrassPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOGrassPower', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTAOEnvironmentPower', 2, GC_V_PTAOEnvironmentPower( RoundF( GC_GetNum( cfg, 'GC_PTAmbientOcclusion', 'GCP_PTAOEnvironmentPower', 0.0 ) ) ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'PTAOEnable', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOQuality', 1, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAODenoisePasses', 1, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOStrength', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAORadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAORadiusMultiplier', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOFalloffRange', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOFinalValuePower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOCharacterRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOSkinRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOHairRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOTerrainRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOTreesRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOGrassRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOEnvironmentRadius', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOCharacterPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOSkinPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOHairPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOTerrainPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOTreesPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOGrassPower', 2, -1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTAOEnvironmentPower', 2, -1.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_PTAmbientOcclusion', on );
	}
	return changed;
}

function GC_Group_GC_PTHair( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_PTHair', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_PTHair', false );
	if ( on )
	{
		GC_Push( cfg, 'GC_Bind', 'PTHairDirectLightImpact', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairDirectLightImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairGlobalLightImpact', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairGlobalLightImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairIndirectLightImpact', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairIndirectLightImpact', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairSpecularTintScale', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairSpecularTintScale', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairGameLightIndirect', 0, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairGameLightIndirect', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairGameplayCameraFill', 0, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairGameplayCameraFill', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairInteriorExteriorDimmer', 0, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairInteriorExteriorDimmer', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughness', 2, GC_V_PTHairRoughness( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRoughness', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughnessAzimuthal', 2, GC_V_PTHairRoughnessAzimuthal( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRoughnessAzimuthal', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughnessLongitudinal', 2, GC_V_PTHairRoughnessLongitudinal( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRoughnessLongitudinal', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRoughnessExponent', 2, ClampF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRoughnessExponent', 0.25 ), 0.10000000149011612, 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootRoughness', 2, ClampF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRootRoughness', 1.0 ), -1.0, 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootRoughnessRange', 2, ClampF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRootRoughnessRange', 0.05 ), 0.0, 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairWetRoughness', 2, ClampF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairWetRoughness', 0.03 ), -1.0, 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairDiffuseFloor', 2, GC_V_PTHairDiffuseFloor( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairDiffuseFloor', 0.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootAlphaFalloffOverride', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRootAlphaFalloffOverride', 0.06 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairRootAlphaMode', 1, GC_V_PTHairRootAlphaMode( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairRootAlphaMode', 1.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairBSDFMode', 1, GC_V_PTHairBSDFMode( RoundF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairBSDFMode', 1.0 ) ) ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOcclusionMode', 1, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairShadowOcclusionMode', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOriginSpreadScope', 1, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairShadowOriginSpreadScope', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairShadowOriginSpread', 2, ClampF( GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairShadowOriginSpread', 32.0 ), 0.0, 100.0 ) );
		GC_Push( cfg, 'GC_Bind', 'PTHairAlphaTestMipLevel', 2, GC_GetNum( cfg, 'GC_PTHair', 'GCP_PTHairAlphaTestMipLevel', 4.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'PTHairDirectLightImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairGlobalLightImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairIndirectLightImpact', 2, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'PTHairSpecularTintScale', 2, 1.0 );
