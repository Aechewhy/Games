function GC_Group_GC_Water( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_Water', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_Water', false );
	if ( on )
	{
		cur = GC_GetNum( cfg, 'GC_Bind', 'GlobalOceanTesselationFactor', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_Water', 'GCP_GlobalOceanTesselationFactor', 52.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_GlobalOceanTesselationFactor', 1, 52.0, 8.0, 16.0, 32.0, 48.0, 52.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Water', 'GCP_GlobalOceanTesselationFactor', GC_Str( 1, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'GlobalOceanTesselationFactor', 1, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'UseDynamicWaterSimulation', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_Water', 'GCP_UseDynamicWaterSimulation', 1.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_UseDynamicWaterSimulation', 0, 1.0, 0.0, 0.0, 1.0, 1.0, 1.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Water', 'GCP_UseDynamicWaterSimulation', GC_Str( 0, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'UseDynamicWaterSimulation', 0, usr );
		GC_Push( cfg, 'GC_Bind', 'WaterFogPerPixel', 0, GC_GetNum( cfg, 'GC_Water', 'GCP_WaterFogPerPixel', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'AllowUnderwater', 0, GC_GetNum( cfg, 'GC_Water', 'GCP_AllowUnderwater', 1.0 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'GlobalOceanTesselationFactor', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_GlobalOceanTesselationFactor', 52.0 ) );
		GC_Push( cfg, 'GC_Bind', 'UseDynamicWaterSimulation', 0, GC_GetNum( cfg, 'GC_Store', 'GCV_UseDynamicWaterSimulation', 1.0 ) );
		GC_Push( cfg, 'GC_Bind', 'WaterFogPerPixel', 0, 1.0 );
		GC_Push( cfg, 'GC_Bind', 'AllowUnderwater', 0, 1.0 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_Water', on );
	}
	return changed;
}

function GC_Group_GC_DecalsEffects( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_DecalsEffects', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_DecalsEffects', false );
	if ( on )
