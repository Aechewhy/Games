		cfg.SetVarValue( 'GC_Sharpening', 'GCP_CASDistanceDecayPower', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'CASDistanceDecayPower', 1.5 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_CASDenoise', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'CASDenoise', 1.0 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_CASFast', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'CASFast', 0.0 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_RCASAmount', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'RCASAmount', 0.2 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_FSRSharpnessLow', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'FSRSharpnessLow', 0.3 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_FSRSharpnessHigh', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'FSRSharpnessHigh', 1.0 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_NISSharpness', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'NISSharpness', 0.2 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_TAAUseLDS', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'TAAUseLDS', 0.0 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_MotionBlurPositionTreshold', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'MotionBlurPositionTreshold', 0.05 ) ) );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_MotionBlurRotationTreshold', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'MotionBlurRotationTreshold', 1.0 ) ) );
		cfg.SetVarValue( 'GC_Water', 'GCP_GlobalOceanTesselationFactor', GC_Str( 1, GC_GetNum( cfg, 'GC_Bind', 'GlobalOceanTesselationFactor', 52.0 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_GlobalOceanTesselationFactor', "52" );
		cfg.SetVarValue( 'GC_Water', 'GCP_UseDynamicWaterSimulation', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'UseDynamicWaterSimulation', 1.0 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_UseDynamicWaterSimulation', "true" );
		cfg.SetVarValue( 'GC_Water', 'GCP_WaterFogPerPixel', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'WaterFogPerPixel', 1.0 ) ) );
		cfg.SetVarValue( 'GC_Water', 'GCP_AllowUnderwater', GC_Str( 0, GC_GetNum( cfg, 'GC_Bind', 'AllowUnderwater', 1.0 ) ) );
		cfg.SetVarValue( 'GC_DecalsEffects', 'GCP_DecalsChance', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'DecalsChance', 1.0 ) ) );
		cfg.SetVarValue( 'GC_DecalsEffects', 'GCP_DecalsSpawnDistanceCutoff', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'DecalsSpawnDistanceCutoff', 10.0 ) ) );
		cfg.SetVarValue( 'GC_DecalsEffects', 'GCP_DynamicDecalsLimit', GC_Str( 1, GC_GetNum( cfg, 'GC_Bind', 'DynamicDecalsLimit', 60.0 ) ) );
		cfg.SetVarValue( 'GC_DecalsEffects', 'GCP_DynamicDecalsChunkLimit', GC_Str( 1, GC_GetNum( cfg, 'GC_Bind', 'DynamicDecalsChunkLimit', 30.0 ) ) );
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_Textures', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_Shadows', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_LightingRT', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_PathTracing', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_PTAmbientOcclusion', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_PTHair', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_PTCaustics', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_Sharpening', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_Water', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_DecalsEffects', 'GCP_On', "true" );
		cfg.SetVarValue( 'GC_Presets', 'GCP_Master', "true" );
		cfg.SetVarValue( 'GC_Presets', 'GCP_SeeThrough', "false" );
	}
	// 1.2.1: the path tracing preset list keeps its own position
	if ( ver < 1 )
	{
		cfg.SetVarValue( 'GC_Presets', 'GCP_PTPreset', "5" );
	}
	else if ( ver < 3 )
	{
		cfg.SetVarValue( 'GC_Presets', 'GCP_PTPreset', "6" );
	}
	if ( ver < 4 )
	{
		// new in 1.2.2: start from what the engine has now
		cfg.SetVarValue( 'GC_DrawDistance', 'GCP_TerrainErrorMetricMultiplier', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'TerrainErrorMetricMultiplier', 10.0 ) ) );
		cfg.SetVarValue( 'GC_Store', 'GCV_TerrainErrorMetricMultiplier', "10" );
	}
	cfg.SetVarValue( 'GC_Store', 'GC_Version', "4" );
}

// ---- applying ----

function GC_Group_GC_DrawDistance( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_DrawDistance', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_DrawDistance', false );
	if ( on )
	{
		cur = GC_GetNum( cfg, 'GC_Bind', 'MeshRenderingDistanceScale', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_MeshRenderingDistanceScale', 1.5 ), 1.0, 10.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_MeshRenderingDistanceScale', 2, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MeshRenderingDistanceScale', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'MeshRenderingDistanceScale', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'MeshLODDistanceScale', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_MeshLODDistanceScale', 1.5 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_MeshLODDistanceScale', 2, 1.5, 1.0, 1.0, 1.2, 1.3, 1.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MeshLODDistanceScale', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'MeshLODDistanceScale', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'FoliageDistanceScale', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_FoliageDistanceScale', 1.8 ), 0.0, 5.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_FoliageDistanceScale', 2, 1.8, 1.0, 1.2, 1.5, 1.8, 1.8 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_FoliageDistanceScale', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'FoliageDistanceScale', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'MaxVisibilityDepth', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_MaxVisibilityDepth', 24.0 ), 0.0, 24.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_MaxVisibilityDepth', 1, 24.0, 4.0, 8.0, 12.0, 24.0, 24.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_MaxVisibilityDepth', GC_Str( 1, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'MaxVisibilityDepth', 1, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'TerrainErrorMetricMultiplier', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_TerrainErrorMetricMultiplier', 10.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_TerrainErrorMetricMultiplier', 2, 10.0, 30.0, 20.0, 10.0, 6.0, 10.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_TerrainErrorMetricMultiplier', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'TerrainErrorMetricMultiplier', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThreshold', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_TerrainScreenSpaceErrorThreshold', 1.6 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_TerrainScreenSpaceErrorThreshold', 2, 1.6, 4.0, 3.0, 2.0, 1.6, 1.6 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_TerrainScreenSpaceErrorThreshold', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThreshold', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThresholdFar', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_TerrainScreenSpaceErrorThresholdFar', 3.5 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_TerrainScreenSpaceErrorThresholdFar', 2, 3.5, 8.0, 7.0, 5.0, 3.5, 3.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_TerrainScreenSpaceErrorThresholdFar', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThresholdFar', 2, usr );
		GC_Push( cfg, 'GC_Bind', 'TerrainReadAheadDistance', 2, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_TerrainReadAheadDistance', 200.0 ) );
		GC_Push( cfg, 'GC_Bind', 'MeshLodGameplayDownscale', 1, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_MeshLodGameplayDownscale', 0.0 ) );
		GC_Push( cfg, 'GC_Bind', 'CharacterLodGameplayDownscale', 1, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_CharacterLodGameplayDownscale', 0.0 ) );
		cur = GC_GetNum( cfg, 'GC_Bind', 'DecalsHideDistance', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_DecalsHideDistance', 90.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_DecalsHideDistance', 2, 90.0, 15.0, 30.0, 40.0, 80.0, 90.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_DecalsHideDistance', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'DecalsHideDistance', 2, usr );
		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsHideDistance', 2, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_DynamicDecalsHideDistance', 20.0 ) );
		GC_Push( cfg, 'GC_Bind', 'StripeHideDistance', 2, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_StripeHideDistance', 60.0 ) );
		GC_Push( cfg, 'GC_Bind', 'SwarmHideDistance', 2, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_SwarmHideDistance', 200.0 ) );
		GC_Push( cfg, 'GC_Bind', 'DimmerHideDistance', 2, GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_DimmerHideDistance', 60.0 ) );
		cur = GC_GetNum( cfg, 'GC_Bind', 'SpawnedLimit', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_DrawDistance', 'GCP_SpawnedLimit', 160.0 ), 1.0, 1000.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_SpawnedLimit', 1, 160.0, 75.0, 100.0, 130.0, 150.0, 160.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_DrawDistance', 'GCP_SpawnedLimit', GC_Str( 1, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'SpawnedLimit', 1, usr );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'MeshRenderingDistanceScale', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_MeshRenderingDistanceScale', 1.5 ) );
		GC_Push( cfg, 'GC_Bind', 'MeshLODDistanceScale', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_MeshLODDistanceScale', 1.5 ) );
		GC_Push( cfg, 'GC_Bind', 'FoliageDistanceScale', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_FoliageDistanceScale', 1.8 ) );
		GC_Push( cfg, 'GC_Bind', 'MaxVisibilityDepth', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_MaxVisibilityDepth', 24.0 ) );
		GC_Push( cfg, 'GC_Bind', 'TerrainErrorMetricMultiplier', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_TerrainErrorMetricMultiplier', 10.0 ) );
		GC_Push( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThreshold', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_TerrainScreenSpaceErrorThreshold', 1.6 ) );
		GC_Push( cfg, 'GC_Bind', 'TerrainScreenSpaceErrorThresholdFar', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_TerrainScreenSpaceErrorThresholdFar', 3.5 ) );
		GC_Push( cfg, 'GC_Bind', 'TerrainReadAheadDistance', 2, 200.0 );
		GC_Push( cfg, 'GC_Bind', 'MeshLodGameplayDownscale', 1, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'CharacterLodGameplayDownscale', 1, 0.0 );
		GC_Push( cfg, 'GC_Bind', 'DecalsHideDistance', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_DecalsHideDistance', 90.0 ) );
		GC_Push( cfg, 'GC_Bind', 'DynamicDecalsHideDistance', 2, 20.0 );
		GC_Push( cfg, 'GC_Bind', 'StripeHideDistance', 2, 60.0 );
		GC_Push( cfg, 'GC_Bind', 'SwarmHideDistance', 2, 200.0 );
		GC_Push( cfg, 'GC_Bind', 'DimmerHideDistance', 2, 60.0 );
		GC_Push( cfg, 'GC_Bind', 'SpawnedLimit', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_SpawnedLimit', 160.0 ) );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_DrawDistance', on );
	}
	return changed;
}

function GC_Group_GC_GrassFoliage( cfg : CInGameConfigWrapper, master : bool ) : bool
{
	var on, was, changed : bool;
	var cur, usr : float;
	on = master && GC_GetBool( cfg, 'GC_GrassFoliage', 'GCP_On', true );
	was = GC_GetBool( cfg, 'GC_Store', 'GCA_GC_GrassFoliage', false );
	if ( on )
	{
		cur = GC_GetNum( cfg, 'GC_Bind', 'GrassDensity', -1000000.0 );
		usr = GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_GrassDensity', 6000.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_GrassDensity', 2, 6000.0, 1400.0, 2400.0, 3500.0, 4750.0, 6000.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_GrassDensity', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'GrassDensity', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'GrassDistanceScale', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_GrassDistanceScale', 2.5 ), 0.0, 5.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_GrassDistanceScale', 2, 2.5, 1.0, 1.5, 2.0, 2.5, 2.5 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_GrassDistanceScale', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'GrassDistanceScale', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'GrassRingSize', -1000000.0 );
		usr = GC_V_GrassRingSize( RoundF( GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_GrassRingSize', 3.0 ) ) );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_GrassRingSize', 1, 8388608.0, 2097152.0, 3145728.0, 6291456.0, 8388608.0, 8388608.0 ) )
		{
			cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_GrassRingSize', IntToString( GC_I_GrassRingSize( cur ) ) );
			usr = GC_V_GrassRingSize( GC_I_GrassRingSize( cur ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'GrassRingSize', 1, usr );
		GC_Push( cfg, 'GC_Bind', 'SRTGrassExtraRange', 2, GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_SRTGrassExtraRange', 2.0 ) );
		GC_Push( cfg, 'GC_Bind', 'GrassDensityLodScale', 2, ClampF( GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_GrassDensityLodScale', 0.75 ), 0.5, 2.0 ) );
		cur = GC_GetNum( cfg, 'GC_Bind', 'FoliageShadowDistanceScale', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_FoliageShadowDistanceScale', 54.0 ), 0.0, 64.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_FoliageShadowDistanceScale', 2, 54.0, 8.0, 12.0, 16.0, 48.0, 54.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_GrassFoliage', 'GCP_FoliageShadowDistanceScale', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'FoliageShadowDistanceScale', 2, usr );
		GC_Push( cfg, 'GC_Bind', 'WindScale', 2, GC_GetNum( cfg, 'GC_GrassFoliage', 'GCP_WindScale', 0.7 ) );
	}
	else if ( was )
	{
		GC_Push( cfg, 'GC_Bind', 'GrassDensity', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_GrassDensity', 6000.0 ) );
		GC_Push( cfg, 'GC_Bind', 'GrassDistanceScale', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_GrassDistanceScale', 2.5 ) );
		GC_Push( cfg, 'GC_Bind', 'GrassRingSize', 1, GC_GetNum( cfg, 'GC_Store', 'GCV_GrassRingSize', 8388608.0 ) );
		GC_Push( cfg, 'GC_Bind', 'SRTGrassExtraRange', 2, 2.0 );
		GC_Push( cfg, 'GC_Bind', 'GrassDensityLodScale', 2, 0.75 );
		GC_Push( cfg, 'GC_Bind', 'FoliageShadowDistanceScale', 2, GC_GetNum( cfg, 'GC_Store', 'GCV_FoliageShadowDistanceScale', 54.0 ) );
		GC_Push( cfg, 'GC_Bind', 'WindScale', 2, 0.7 );
	}
	if ( on != was )
	{
		GC_SetBool( cfg, 'GC_Store', 'GCA_GC_GrassFoliage', on );
	}
	return changed;
}

function GC_Group_GC_Textures( cfg : CInGameConfigWrapper, master : bool ) : bool
