		cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowDistanceScale2', GC_Str( 2, GC_GetNum( cfg, 'GC_Bind', 'CascadeShadowDistanceScale2', 1.5 ) ) );
