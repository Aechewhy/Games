		GC_Push( cfg, 'GC_Bind', 'CascadeShadowDistanceScale3', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'CascadeShadowFadeTreshold', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_Shadows', 'GCP_CascadeShadowFadeTreshold', 1.0 ), 0.10000000149011612, 10.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_CascadeShadowFadeTreshold', 2, 1.0, 2.0, 1.5, 1.0, 1.0, 1.0 ) )
		{
			usr = cur;
			cfg.SetVarValue( 'GC_Shadows', 'GCP_CascadeShadowFadeTreshold', GC_Str( 2, usr ) );
			changed = true;
		}
		GC_Push( cfg, 'GC_Bind', 'CascadeShadowFadeTreshold', 2, usr );
		cur = GC_GetNum( cfg, 'GC_Bind', 'MaxTerrainShadowAtlasCount', -1000000.0 );
		usr = ClampF( GC_GetNum( cfg, 'GC_Shadows', 'GCP_MaxTerrainShadowAtlasCount', 4.0 ), 1.0, 5.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_MaxTerrainShadowAtlasCount', 1, 4.0, 2.0, 3.0, 4.0, 4.0, 4.0 ) )
		{
			usr = cur;
