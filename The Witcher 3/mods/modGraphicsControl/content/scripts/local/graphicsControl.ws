		usr = GC_GetNum( cfg, 'GC_Textures', 'GCP_DetailTextureDownscale', 0.0 );
		if ( GC_Track( cfg, was, cur, usr, 'GCV_DetailTextureDownscale', 1, 0.0, 2.0, 1.0, 0.0, 0.0, 0.0 ) )
		{
			usr = cur;
